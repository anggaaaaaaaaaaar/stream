<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryGrayBackground">

    <ImageView
        android:id="@+id/home_scroll_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/example_poster" />

    <View
        android:id="@+id/title_shadow_top"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:alpha="1"
        android:background="@drawable/background_shadow"
        android:rotation="180"
        android:visibility="visible" />

    <View
        android:id="@+id/title_shadow"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_gravity="bottom"
        android:background="@drawable/hero_bottom_scrim" />

    <!-- Bottom margin leaves room for the play row and page dots in fragment_home_head -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/hero_controls_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/hero_side_padding">

        <ImageView
            android:id="@+id/home_preview_logo"
            android:layout_width="240dp"
            android:layout_height="90dp"
            android:layout_gravity="start"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:paddingBottom="12dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/home_scroll_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingBottom="12dp"
            android:textColor="?attr/white"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="The Perfect Run" />

        <TextView
            android:id="@+id/home_scroll_preview_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingBottom="10dp"
            android:textColor="@color/heroMetaText"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="★ 8.0  ·  2026  ·  Adventure" />

        <TextView
            android:id="@+id/home_scroll_preview_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/heroPlotText"
            android:textSize="15sp"
            tools:text="Odysseus, the legendary King of Ithaca, embarks on a long and perilous journey home following the Trojan War." />
    </LinearLayout>

</FrameLayout>
